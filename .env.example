# ── 2GIS Catalog API key ────────────────────────────────────────────────
# Get your own key in the 2GIS developer portal: https://dev.2gis.com/
# (check the portal for current terms and limits of your key).
# Copy this file to .env and paste the key below. Never commit .env.
TWOGIS_API_KEY=PUT_YOUR_2GIS_KEY_HERE

# Base host for the Catalog API (usually no need to change)
TWOGIS_BASE_URL=https://catalog.api.2gis.com

# Optional tuning
REQUEST_TIMEOUT_MS=15000
RATE_LIMIT_MS=350
MAX_RETRIES=4
LOG_LEVEL=info
